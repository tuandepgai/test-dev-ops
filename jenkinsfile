pipeline {
    agent any

    environment {
        JAVA_HOME = "C:/Program Files/Java/jdk-21" // sửa theo JDK 21 trên host Windows
        PATH = "${JAVA_HOME}/bin;${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/tuandepgai/test-dev-ops.git'
            }
        }

        stage('Check Java') {
            steps {
                bat 'java -version'
                bat 'javac -version'
            }
        }

        stage('Build') {
            steps {
                bat 'gradlew clean build -x test'
            }
        }

        stage('Build Docker Image') {
            steps {
                // dùng Minikube Docker daemon
                bat 'minikube -p minikube docker-env --shell powershell | Invoke-Expression'
                bat 'docker build -t tuan-app:latest .'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                // chạy kubectl qua Minikube
                bat 'minikube -p minikube kubectl -- apply -f src\\main\\resources\\config\\k8s-deploy.yaml'
                bat 'minikube -p minikube kubectl -- rollout status deployment tuan-app-deployment'
            }
        }
    }

    post {
        failure {
            echo 'Pipeline thất bại!'
        }
        success {
            echo 'Pipeline chạy thành công!'
        }
    }
}
