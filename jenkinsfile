pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        // JAVA_HOME trỏ tới JDK 21 trên agent
        JAVA_HOME = "/opt/java/openjdk"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/tuandepgai/test-dev-ops.git'
            }
        }

        stage('Check Java') {
            steps {
                sh 'java -version'
                sh 'javac -version'
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x gradlew'
                sh './gradlew clean build -x test' // bỏ test nếu muốn nhanh hơn
            }
        }

        stage('Build Docker Image') {
                   steps {
                       // Dùng docker của Minikube host
                       sh 'eval $(minikube -p minikube docker-env)'
                       sh 'docker build -t tuan-app:latest .'
                   }
               }

        stage('Deploy to Kubernetes') {
            steps {
                // Dùng kubeconfig của Minikube
                sh 'kubectl apply -f src/main/resources/config/k8s-deploy.yaml'
                sh 'kubectl rollout status deployment tuan-app-deployment'
            }
        }
    }

    post {
        failure {
            echo 'Pipeline thất bại!'
        }
        success {
            echo 'Pipeline chạy thành công!'
        }
    }
}
