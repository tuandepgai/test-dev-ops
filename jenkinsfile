pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/tuandepgai/test-dev-ops.git'
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x gradlew'
                sh './gradlew clean build'
            }
        }

        stage('Build Docker Image') {
            steps {
                // Nếu Jenkins chạy cùng Minikube
                sh 'eval $(minikube -p minikube docker-env)'
                sh 'docker build -t tuan-app:latest .'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f src/main/resources/config/k8s-deploy.yaml'
            }
        }
    }
}
