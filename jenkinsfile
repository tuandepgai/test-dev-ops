pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/tuandepgai/test-dev-ops.git',
                    credentialsId: 'a2ab45ac-b3cf-4ad0-8e0e-c678fe8eee0c'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t tuan-app .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d --name tuan-app -p 8080:8080 tuan-app'
            }
        }
    }
}
