pipeline {
    agent any

    triggers {
        githubPush() // trigger tự động khi GitHub push
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/tuandepgai/test-dev-ops.git'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t tuan-app .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker rm -f tuan-app || true  # xóa container cũ nếu có
                docker run -d --name tuan-app -p 8080:8080 tuan-app
                '''
            }
        }
    }
}
